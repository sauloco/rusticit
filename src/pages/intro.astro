---
import { Image } from 'astro:assets'
import BaseHead from "../components/BaseHead.astro";
import ConsentBanner from "../components/ConsentBanner.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import LogoDark from '../assets/rustic-logo-dark.svg'
import Logo from '../assets/rustic-logo-light.svg'
import BookerIframe from '@components/react/BookerIframe'

const roles = [
  { value: "ceo",   label: "CEO" },
  { value: "cto",   label: "CTO" },
  { value: "other", label: "Other" },
];

const teamSizes = [
  { value: "1-5",  label: "1–5" },
  { value: "6-20", label: "6–20" },
  { value: "20+",  label: "20+" },
];

const timelines = [
  { value: "immediately", label: "Immediately" },
  { value: "1-3mo",       label: "Within 1–3 months" },
  { value: "exploring",   label: "Exploring" },
];

const trustSignals = [
  { icon: "◆", text: "Senior full-stack product engineer — Vue, React, TypeScript, Node.js, APIs, and AI integration" },
  { icon: "◆", text: "Experience on German engineering platforms, medical visualization, public-sector systems" },
  { icon: "◆", text: "No juniors. No agency layers. Direct collaboration." },
];

const title = "Book a Free 20-Min Intro Call — RusticIT"
---

<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Instant dark mode — same snippet as Base.astro -->
  <script is:inline>
    (function(){try{var p=localStorage.getItem('theme');if(p==='dark'||((!p||p==='system')&&window.matchMedia('(prefers-color-scheme: dark)').matches))document.documentElement.classList.add('dark')}catch(e){}})();
  </script>
  <BaseHead
    title={title}
    description="RusticIT helps B2B SaaS teams unblock full-stack product delivery. Senior execution, no layers, no guesswork. Book your free intro call today."
  />
</head>

<body class="
  bg-offwhite dark:bg-charcoal
  text-charcoal dark:text-offwhite
  font-sans antialiased
  selection:bg-purple-light/30
  min-h-screen
">

  <!-- ── Background texture ──────────────────────────────────────────────── -->
  <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden" aria-hidden="true">
    <div class="absolute inset-0 opacity-[0.025] dark:opacity-[0.04]"
         style="background-image: repeating-linear-gradient(0deg, #353535 0px, #353535 1px, transparent 1px, transparent 48px), repeating-linear-gradient(90deg, #353535 0px, #353535 1px, transparent 1px, transparent 48px);">
    </div>
    <div class="absolute -top-1/2 -right-1/4 w-[800px] h-[800px] rounded-full opacity-[0.06] dark:opacity-[0.12] blur-3xl animate-pulse-slowglow"
         style="background: radial-gradient(circle, #9C1DE7 0%, #581B98 50%, transparent 75%);">
    </div>
  </div>

  <!-- ── Top bar ─────────────────────────────────────────────────────────── -->
  <header class="relative z-10 px-6 py-5 flex items-center justify-between gap-4 max-w-3xl mx-auto">
    <div class="flex items-center gap-4">
      <Image src={Logo} alt="RusticIT" width={120} class="block dark:hidden"></Image>
      <Image src={LogoDark} alt="RusticIT" width={120} class="hidden dark:block"></Image>
      <div class="font-mono text-xs tracking-widest text-crimson mt-4 uppercase flex items-center gap-3">
        <span class="w-8 h-px bg-crimson inline-block"></span>
        Book your free 20-min intro call
      </div>
    </div>
    <ThemeToggle />
  </header>

  <main class="relative z-10 px-6 pb-24">
    <div class="max-w-3xl mx-auto">

      <!-- ── Hero ──────────────────────────────────────────────────────── -->
      <section class="pt-16 pb-20 md:pt-24 md:pb-28">


        <h1 class="font-heading font-black leading-[1.05] tracking-tight text-charcoal dark:text-offwhite mb-6" style="font-size: clamp(2.4rem, 6vw, 4.5rem);">
          Product complexity is<br/>
          <span class="relative inline-block">
            slowing delivery
            <span class="underline-grow absolute bottom-1 left-0 right-0 h-[3px] bg-gradient-to-r from-crimson from-[90%] to-purple-light rounded-full opacity-80 -z-10"></span>
          </span><br/>
          down.
        </h1>

        <p class="text-charcoal/65 dark:text-offwhite/60 font-sans text-lg md:text-xl leading-relaxed max-w-xl mb-12">
          RusticIT helps B2B SaaS teams unblock delivery —<br class="hidden md:inline"/>
          <strong class="text-charcoal dark:text-offwhite font-semibold">senior execution, no layers, no guesswork.</strong>
        </p>
      </section>

      <!-- ── Trust signals ──────────────────────────────────────────────── -->
      <section class="pb-20 border-t border-charcoal/10 dark:border-offwhite/10 pt-12">
        <ul class="flex flex-col gap-5">
          {trustSignals.map(item => (
            <li class="flex items-start gap-4">
              <span class="font-mono text-[10px] text-purple-light mt-[5px] shrink-0 leading-none" aria-hidden="true">{item.icon}</span>
              <span class="text-charcoal/80 dark:text-offwhite/75 text-sm md:text-base leading-snug">{item.text}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- ── Qualifier form ─────────────────────────────────────────────── -->
      <section id="qualifier" class="scroll-mt-8">

        <div id="form-block">
          <div class="mb-10">
            <h2 class="font-heading font-bold text-2xl md:text-3xl text-charcoal dark:text-offwhite mb-2">
              Tell me about your situation
            </h2>
            <p class="text-charcoal/55 dark:text-offwhite/50 text-sm">
              Takes 60 seconds. I'll confirm a time within one business day.
            </p>
          </div>

          <form id="intro-form" novalidate class="flex flex-col gap-7">

            <!-- Row 1: name + email -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-7">
              <div class="field-group">
                <label for="name" class="field-label">Full name <span class="text-crimson">*</span></label>
                <input id="name" name="name" type="text" required autocomplete="name"
                       placeholder="Jane Smith"
                       class="field-input" />
              </div>
              <div class="field-group">
                <label for="email" class="field-label">Work email <span class="text-crimson">*</span></label>
                <input id="email" name="email" type="email" required autocomplete="email"
                       placeholder="jane@acme.com"
                       class="field-input" />
              </div>
            </div>

            <!-- Row 2: company -->
            <div class="field-group">
              <label for="company" class="field-label">Company <span class="text-crimson">*</span></label>
              <input id="company" name="company" type="text" required autocomplete="organization"
                     placeholder="Acme SaaS Inc."
                     class="field-input" />
            </div>

            <!-- Row 2: role + team size -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-7">
              <fieldset>
                <legend class="field-label mb-4">Your role <span class="text-crimson">*</span></legend>
                <div class="flex flex-wrap gap-3">
                  {roles.map(opt => (
                    <label class="radio-pill">
                      <input type="radio" name="role" value={opt.value} required class="sr-only radio-input" />
                      <span class="radio-label">{opt.label}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
              <fieldset>
                <legend class="field-label mb-4">Team size <span class="text-crimson">*</span></legend>
                <div class="flex flex-wrap gap-3">
                  {teamSizes.map(opt => (
                    <label class="radio-pill">
                      <input type="radio" name="team_size" value={opt.value} required class="sr-only radio-input" />
                      <span class="radio-label">{opt.label}</span>
                    </label>
                  ))}
                </div>
              </fieldset>
            </div>

            <!-- Challenge -->
            <div class="field-group">
              <label for="challenge" class="field-label">
                Biggest product delivery challenge right now <span class="text-crimson">*</span>
              </label>
              <input id="challenge" name="challenge" type="text" required
                     placeholder="e.g. slow delivery, fragile APIs, messy workflows..."
                     class="field-input" />
            </div>

            <!-- Timeline -->
            <fieldset>
              <legend class="field-label mb-4">When do you need help? <span class="text-crimson">*</span></legend>
              <div class="flex flex-wrap gap-3">
                {timelines.map(opt => (
                  <label class="radio-pill">
                    <input type="radio" name="timeline" value={opt.value} required class="sr-only radio-input" />
                    <span class="radio-label">{opt.label}</span>
                  </label>
                ))}
              </div>
            </fieldset>

            <!-- Error message -->
            <p id="form-error" class="hidden text-crimson text-sm font-mono" aria-live="polite"></p>

            <!-- Submit -->
            <div class="pt-2">
              <button type="submit"
                      class="
                        w-full md:w-auto
                        inline-flex items-center justify-center gap-3
                        bg-charcoal dark:bg-offwhite
                        text-offwhite dark:text-charcoal
                        font-heading font-bold text-base tracking-tight
                        px-8 py-4 rounded-lg
                        hover:opacity-90 active:scale-[0.98]
                        transition-all duration-150
                      ">
                Continue to booking
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                  <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </button>
            </div>
          </form>
        </div>

        <!-- ── Booking widget (hidden until form submit) ──────────────── -->
        <div id="booking-block" class="hidden" tabindex="-1" aria-labelledby="booking-heading">
          <div class="mb-8">
            <div class="flex items-center gap-3 mb-4">
              <span class="w-6 h-6 rounded-full bg-crimson/15 flex items-center justify-center text-crimson text-xs font-bold" aria-hidden="true">✓</span>
              <h2 id="booking-heading" class="font-heading font-semibold text-lg text-charcoal dark:text-offwhite">Thanks — pick a time that works for you.</h2>
            </div>
            <p class="text-charcoal/55 dark:text-offwhite/50 text-sm pl-9">
              20 minutes. No pitch deck, no fluff — just a direct conversation about your situation.
            </p>
          </div>

          <!-- Cal.com embed placeholder -->
          <div class="
            rounded-xl border border-charcoal/10 dark:border-offwhite/10
            bg-charcoal/[0.03] dark:bg-offwhite/[0.03]
            p-10 flex flex-col items-center justify-center text-center gap-4
            min-h-[360px] relative
          ">
            <BookerIframe client:only="react" />
          </div>
        </div>

      </section>

    </div>

  </main>

  <!-- ── Minimal footer ──────────────────────────────────────────────────── -->
  <footer class="relative z-10 px-6 py-8 border-t border-charcoal/8 dark:border-offwhite/8">
    <div class="max-w-3xl mx-auto flex items-center justify-between gap-4 flex-wrap">
      <span class="font-mono text-xs text-charcoal/35 dark:text-offwhite/30">
        © {new Date().getFullYear()} RusticIT · <a href="/privacy/" class="hover:text-crimson transition-colors">Privacy</a>
      </span>
      <a href="/" class="font-mono text-xs text-charcoal/35 dark:text-offwhite/30 hover:text-crimson dark:hover:text-crimson transition-colors">
        ← Back to rusticit.com
      </a>
    </div>
  </footer>

  <ConsentBanner />

</body>
</html>

<style>
  /* ── Underline grow animation ────────────────────────────────────────── */
  .underline-grow {
    transform: scaleX(0);
    transform-origin: left center;
    animation: underline-grow 4s steps(32, end) 0.5s forwards;
  }

  @keyframes underline-grow {
    to { transform: scaleX(1); }
  }

  /* ── Field components ─────────────────────────────────────────────────── */
  .field-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .field-label {
    font-family: var(--font-mono) monospace;
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(53 53 53 / 0.5);
  }

  :global(.dark) .field-label {
    color: rgb(247 247 247 / 0.45);
  }

  .field-input {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1.5px solid rgb(53 53 53 / 0.18);
    padding: 0.6rem 0;
    font-family: var(--font-sans) monospace;
    font-size: 0.9375rem;
    color: #353535;
    outline: none;
    transition: border-color 0.15s ease;
    border-radius: 0;
    appearance: none;
  }

  :global(.dark) .field-input {
    border-bottom-color: rgb(247 247 247 / 0.18);
    color: #f7f7f7;
  }

  .field-input::placeholder {
    color: rgb(53 53 53 / 0.3);
  }

  :global(.dark) .field-input::placeholder {
    color: rgb(247 247 247 / 0.25);
  }

  .field-input:focus {
    border-bottom-color: #9C1DE7;
  }

  /* ── Radio pills ──────────────────────────────────────────────────────── */
  .radio-pill {
    cursor: pointer;
  }

  .radio-label {
    display: inline-block;
    font-family: var(--font-sans) monospace;
    font-size: 0.875rem;
    padding: 0.5rem 1.125rem;
    border: 1.5px solid rgb(53 53 53 / 0.18);
    border-radius: 100px;
    color: rgb(53 53 53 / 0.7);
    transition: border-color 0.12s ease, color 0.12s ease, background-color 0.12s ease;
    user-select: none;
  }

  :global(.dark) .radio-label {
    border-color: rgb(247 247 247 / 0.18);
    color: rgb(247 247 247 / 0.65);
  }

  .radio-input:checked + .radio-label {
    border-color: #9C1DE7;
    color: #9C1DE7;
    background-color: rgb(156 29 231 / 0.06);
  }

  .radio-pill:hover .radio-label {
    border-color: rgb(156 29 231 / 0.5);
    color: #9C1DE7;
  }

  /* ── Invalid state ────────────────────────────────────────────────────── */
  .field-input.invalid {
    border-bottom-color: #FF073A;
  }
</style>

<script>
  document.addEventListener('astro:page-load', initIntroPage);
  // Also run on direct load (no view transition)
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initIntroPage);
  } else {
    initIntroPage();
  }

  function initIntroPage() {
    const form       = document.getElementById('intro-form') as HTMLFormElement | null;
    const formBlock  = document.getElementById('form-block');
    const booking    = document.getElementById('booking-block');
    const errorEl    = document.getElementById('form-error');

    if (!form || !formBlock || !booking || !errorEl) return;

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      // Clear previous error state
      errorEl.classList.add('hidden');
      errorEl.textContent = '';
      form.querySelectorAll('.invalid').forEach(el => el.classList.remove('invalid'));
      form.querySelectorAll('[aria-invalid="true"]').forEach(el => el.removeAttribute('aria-invalid'));

      // Validate text + email inputs
      const textInputs = form.querySelectorAll<HTMLInputElement>('input[type="text"][required], input[type="email"][required]');
      let firstInvalid: HTMLElement | null = null;

      textInputs.forEach(field => {
        const empty = field.value.trim() === '';
        const invalidEmail = field.type === 'email' && field.value && !field.validity.valid;
        if (empty || invalidEmail) {
          field.classList.add('invalid');
          field.setAttribute('aria-invalid', 'true');
          if (!firstInvalid) firstInvalid = field;
        }
      });

      // Radio group checks
      const radioGroups = ['role', 'team_size', 'timeline'];
      const missingRadio = radioGroups.find(
        name => !form.querySelector(`input[name="${name}"]:checked`)
      );
      if (missingRadio && !firstInvalid) {
        firstInvalid = form.querySelector(`input[name="${missingRadio}"]`);
      }
      if (missingRadio) {
        form.querySelectorAll<HTMLInputElement>(`input[name="${missingRadio}"]`).forEach(field => {
          field.setAttribute('aria-invalid', 'true');
        });
      }

      if (firstInvalid || missingRadio) {
        errorEl.textContent = 'Please fill in all required fields.';
        errorEl.classList.remove('hidden');
        (firstInvalid as HTMLElement | null)?.focus();
        return;
      }

      // Build Cal.com prefill from form values
      const getValue = (selector: string) =>
        (form.querySelector<HTMLInputElement>(selector))?.value?.trim() ?? '';
      const getRadio = (name: string) =>
        (form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`))?.value ?? '';

      const prefill = {
        name: getValue('#name'),
        email: getValue('#email'),
        notes: [
          `Company: ${getValue('#company')}`,
          `Role: ${getRadio('role')}`,
          `Team size: ${getRadio('team_size')}`,
          `Challenge: ${getValue('#challenge')}`,
          `Timeline: ${getRadio('timeline')}`,
        ].join('\n'),
      };

      sessionStorage.setItem('cal_prefill', JSON.stringify(prefill));
      window.dispatchEvent(new CustomEvent('rusticit:cal-prefill', { detail: prefill }));

      // Show booking widget
      formBlock.classList.add('hidden');
      booking.classList.remove('hidden');
      booking.focus({ preventScroll: true });
      booking.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    // Live-clear invalid state on input
    form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('.field-input').forEach(field => {
      field.addEventListener('input', () => field.classList.remove('invalid'));
      field.addEventListener('change', () => field.classList.remove('invalid'));
    });
  }
</script>
