<script>
    // Safe wrapper — umami may not be loaded yet when the script runs
    function track(event: string, data?: Record<string, string | number | boolean>) {
        (window as any).umami?.track(event, data);
    }

    // ── CTA hover / click ─────────────────────────────────────────────────────

    function setupCtaTracking() {
        if ((window as any)._ctaCleanup) (window as any)._ctaCleanup();

        const hoveredLocations = new Set<string>(
            JSON.parse(sessionStorage.getItem("v_cta_hovered") || "[]")
        );
        const cleanups: Array<() => void> = [];

        document.querySelectorAll<HTMLElement>("[data-cta-location]").forEach((el) => {
            const location = el.dataset.ctaLocation!;

            const onMouseenter = () => {
                if (hoveredLocations.has(location)) return;
                hoveredLocations.add(location);
                sessionStorage.setItem("v_cta_hovered", JSON.stringify([...hoveredLocations]));
                track("cta_hover", { location });
            };

            const onClick = () => track("cta_click", { location });

            el.addEventListener("mouseenter", onMouseenter);
            el.addEventListener("click", onClick);
            cleanups.push(
                () => el.removeEventListener("mouseenter", onMouseenter),
                () => el.removeEventListener("click", onClick)
            );
        });

        (window as any)._ctaCleanup = () => cleanups.forEach((fn) => fn());
    }

    // ── Section scroll-into-view ──────────────────────────────────────────────

    function setupSectionTracking() {
        if ((window as any)._sectionObserver) {
            (window as any)._sectionObserver.disconnect();
        }
        if ((window as any)._proofCleanup) (window as any)._proofCleanup();

        const onProofNext = (e: Event) => {
            const { index, author } = (e as CustomEvent).detail;
            track("testimonial_view", { index, author });
        };
        window.addEventListener("rusticit:proof-next", onProofNext);
        (window as any)._proofCleanup = () =>
            window.removeEventListener("rusticit:proof-next", onProofNext);

        const seen = new Set<string>(
            JSON.parse(sessionStorage.getItem("v_seen") || "[]")
        );

        const observer = new IntersectionObserver(
            (entries) => {
                for (const entry of entries) {
                    if (!entry.isIntersecting) continue;
                    const id = (entry.target as HTMLElement).id;
                    if (!id || seen.has(id)) continue;
                    seen.add(id);
                    sessionStorage.setItem("v_seen", JSON.stringify([...seen]));
                    track("section_view", { section: id });
                }
            },
            { threshold: 0.35 }
        );

        document.querySelectorAll("section[id]").forEach((el) => observer.observe(el));
        (window as any)._sectionObserver = observer;
    }

    // ── Form interactions ─────────────────────────────────────────────────────

    function setupFormTracking() {
        if ((window as any)._formCleanup) (window as any)._formCleanup();

        const form = document.querySelector<HTMLFormElement>('form[name="contact"]');
        if (!form) return;

        let touched = false;
        let submitted = false;
        let abandonSent = false;

        const onInput = () => {
            if (touched) return;
            touched = true;
            track("form_touched");
        };

        const submitBtn = form.querySelector<HTMLElement>('button[type="submit"]');
        const onSubmitClick = () => track("form_submit_click");

        const onSubmit = () => {
            submitted = true;
            track("form_submitted");
        };

        const onAbandon = () => {
            if (abandonSent || !touched || submitted) return;
            abandonSent = true;
            track("form_abandoned");
        };

        const onVisibilityChange = () => {
            if (document.visibilityState === "hidden") onAbandon();
        };

        form.addEventListener("input", onInput);
        submitBtn?.addEventListener("click", onSubmitClick);
        form.addEventListener("submit", onSubmit);
        window.addEventListener("beforeunload", onAbandon);
        document.addEventListener("visibilitychange", onVisibilityChange);

        (window as any)._formCleanup = () => {
            form.removeEventListener("input", onInput);
            submitBtn?.removeEventListener("click", onSubmitClick);
            form.removeEventListener("submit", onSubmit);
            window.removeEventListener("beforeunload", onAbandon);
            document.removeEventListener("visibilitychange", onVisibilityChange);
        };
    }

    // ── UTM param capture + clean ─────────────────────────────────────────────

    const TRACKING_KEYS = ["utm_source", "utm_medium", "utm_campaign", "utm_content", "utm_term", "ref", "to", "via", "src"];

    function captureAndCleanTrackingParams() {
        const url = new URL(window.location.href);
        const captured: Record<string, string> = {};

        for (const [key, val] of url.searchParams.entries()) {
            if (TRACKING_KEYS.includes(key) || key.startsWith("utm_")) captured[key] = val;
        }

        if (Object.keys(captured).length > 0) {
            for (const key of Object.keys(captured)) url.searchParams.delete(key);
            history.replaceState({}, "", url.toString());
        }
    }

    // ── Main ──────────────────────────────────────────────────────────────────

    function runTracking() {
        captureAndCleanTrackingParams();

        // Track the page view — umami.track() with no args records the current URL
        (window as any).umami?.track();

        setupCtaTracking();
        setupSectionTracking();
        setupFormTracking();
    }

    document.addEventListener("astro:page-load", () => {
        if (localStorage.getItem("rusticit_consent") === "granted") {
            runTracking();
            return;
        }

        if ((window as any)._visitorTrackerConsentListenerInitialized) return;
        (window as any)._visitorTrackerConsentListenerInitialized = true;

        window.addEventListener(
            "rusticit:consent-granted",
            () => {
                (window as any)._visitorTrackerConsentListenerInitialized = false;
                runTracking();
            },
            { once: true }
        );
    });
</script>
