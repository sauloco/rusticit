---
const title = "Where B2B SaaS teams usually get stuck";
const intro = `When delivery slows down, the problem is rarely just "more frontend work" or "more backend work." It is usually product complexity spreading across the stack: unclear data flows, fragile architecture, inconsistent patterns, integrations, permissions, and workflows that keep growing sprint after sprint.`;
const summary = "I help teams standardize patterns, simplify product architecture, connect frontend and backend decisions, and improve the parts of the system where complexity slows delivery the most.";

const cards = [
    {
        title: "Inconsistent patterns across the product",
        body: "Similar problems get solved in different ways across the UI, API, state, data models, and integrations — increasing bugs, friction, and review time."
    },
    {
        title: "Architecture starts working against delivery",
        body: "Coupling grows between frontend, backend, product logic, and data flows until simple changes require too much coordination and too much risk."
    },
    {
        title: "Product logic keeps compounding",
        body: "Forms, permissions, state, workflows, validations, and edge cases pile up until simple changes stop feeling simple."
    },
    {
        title: "Data-heavy workflows become slow and fragile",
        body: "Dashboards, tables, filters, reports, imports, exports, and API calls start hurting usability and engineering speed at the same time."
    }
];
---

<section id="challenges" aria-labelledby="challenges-title" class="relative py-20 w-full md:py-28 mx-auto px-4 md:px-16 flex flex-col items-center z-30 bg-offwhite dark:bg-charcoal border-t border-charcoal/20">
    <div class="max-w-7xl w-full">
        <h2 id="challenges-title" class="font-heading font-bold text-3xl md:text-5xl text-charcoal dark:text-white mb-6 tracking-tight text-center">
            {title}
        </h2>

        <p class="font-sans text-xl text-charcoal/70 dark:text-offwhite/70 leading-relaxed text-center mb-12 max-w-4xl mx-auto">
            {intro}
        </p>

        <ul class="grid grid-cols-1 md:grid-cols-4 gap-5 md:gap-6">
            {cards.map((card, i) => (
                <li>
                    <article
                        aria-labelledby={`challenge-card-${i + 1}-title`}
                        data-reveal="fade-down"
                        data-reveal-delay={String(i * 120)}
                        class="h-full bg-offwhite dark:bg-charcoal border border-charcoal/10 dark:border-offwhite/10 px-7 py-6 rounded-2xl flex flex-col gap-3 hover:border-charcoal/25 dark:hover:border-offwhite/25 transition-colors"
                    >
                        <h3 id={`challenge-card-${i + 1}-title`} class="font-sans font-semibold text-lg text-charcoal dark:text-offwhite">{card.title}</h3>
                        <p class="font-sans text-charcoal/60 dark:text-offwhite/60 text-base leading-relaxed">{card.body}</p>
                    </article>
                </li>
            ))}
        </ul>

        <p
            data-reveal="fade-up"
            class="font-sans text-lg text-charcoal/50 dark:text-offwhite/50 leading-relaxed text-center mt-10 max-w-3xl mx-auto"
        >
            {summary}
        </p>
    </div>
</section>
