---
const title = "How I usually work with teams";

const steps = [
    {
        title: "Product and technical context",
        description: "We align on the product, the users, the business constraints, the current stack, delivery friction, and the kind of support that would actually help.",
        number: "01"
    },
    {
        title: "Stack and workflow audit",
        description: "I identify the highest-leverage issues across the frontend, backend, data flows, integrations, architecture, and product workflows — including where AI could remove real friction, and where it would just add complexity.",
        number: "02"
    },
    {
        title: "Senior execution",
        description: "I work directly inside the product to ship improvements across the stack with clear priorities, pragmatic tradeoffs, and practical checkpoints.",
        number: "03"
    },
    {
        title: "Documentation and enablement",
        description: "Important decisions, patterns, and tradeoffs get documented so the product becomes easier to maintain after I step out.",
        number: "04"
    }
];

const supportingLine = "Direct senior collaboration across the stack. No junior rotation, no dependency trap, no unnecessary process overhead.";
---

<section id="how-we-work" aria-labelledby="how-we-work-title" class="relative z-30 py-24 md:py-32 w-full mx-auto px-4 md:px-16 flex flex-col items-center border-t border-charcoal/5 dark:border-offwhite/5 bg-offwhite dark:bg-charcoal">
    <div class="max-w-4xl w-full">
        <h2 id="how-we-work-title" class="font-heading font-bold text-3xl md:text-5xl text-charcoal dark:text-white mb-16 tracking-tight text-center">
            {title}
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 w-full">
            {steps.map((step) => (
                <article class="flex flex-col gap-4 relative pl-4 md:pl-0" aria-labelledby={`work-step-${step.number}`}>
                    <div class="absolute left-0 top-0 bottom-0 w-px bg-charcoal/10 dark:bg-offwhite/10 md:hidden" aria-hidden="true"></div>
                    <div class="hidden md:block h-px w-full bg-charcoal/10 dark:bg-offwhite/10 mb-4 relative" aria-hidden="true">
                        <div class="absolute left-0 top-1/2 -translate-y-1/2 w-2 h-2 rounded-full bg-crimson"></div>
                    </div>

                    <span class="font-mono text-crimson font-bold text-sm">{step.number}</span>
                    <h3 id={`work-step-${step.number}`} class="font-sans font-semibold text-lg text-charcoal dark:text-white">{step.title}</h3>
                    <p class="font-sans text-charcoal/70 dark:text-offwhite/70 text-sm leading-relaxed">{step.description}</p>
                </article>
            ))}
        </div>

        <div class="mt-20 text-center rounded-2xl bg-charcoal/5 dark:bg-offwhite/5 border border-charcoal/10 dark:border-offwhite/10 p-6 md:p-8 w-fit mx-auto">
            <p class="font-mono text-sm md:text-base text-charcoal/90 dark:text-offwhite/90 font-medium">
                {supportingLine}
            </p>
        </div>
    </div>
</section>
