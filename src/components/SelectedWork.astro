---
const projects = [
    {
        name: "Sports event platform with an in-product AI coach",
        intro: "A product-led sports platform for tournament organization, live results, sponsor visibility, and community engagement. Includes Match Flow, a live match tracker with an AI coach that reads the momentum of a tennis or padel match and gives players real-time insight while they play — LLM integration, live data flows, and sport-specific prompt design built into a production feature.",
        caseStudy: "/beyond-code/2026_06_shipping-an-ai-coach-into-a-live-tennis-match/",
        matchFlowUrl: "https://entrenolibre.com/match-flow",
    },
    {
        name: "Cross-platform rewrite for the world's most translated digital platforms",
        intro: "Complete rewrite of a 14-year-old cross-platform study app — unifying separate iOS, Android, and desktop codebases into a single modern frontend serving 1,000+ languages and tens of millions of users. Contributed atomic UI components, end-to-end user workflows, and a deep research interface, in close collaboration from design spec to production.",
        caseStudy: "/beyond-code/2026_05_what-contributing-to-a-global-scale-platform-taught-me/",
    },
    {
        name: "Industrial engineering platforms for compliance-sensitive workflows",
        intro: "Browser-based tools used in German engineering environments with structured technical data, validation logic, backend workflows, production data, release automation, and high-trust operational requirements.",
        caseStudy: "",
    },
    {
        name: "Medical visualization platform",
        intro: "A Three.js + Vue application for advanced dental and craniofacial scan analysis, high-resolution imaging, complex planning workflows, and production-grade user interaction around heavy visual data.",
        caseStudy: "/beyond-code/2019_08_building-advanced-dental-imaging-software-on-the-web/",
    },
    {
        name: "Public-sector health systems",
        intro: "Long-lived public-sector health systems with real operational pressure: patient records, databases, reporting tools, internal workflows, user training, and continuity requirements.",
        caseStudy: "/beyond-code/2017_12_designing-a-safe-merge-workflow-for-patient-records-in-a-live-public-health-system/",
    },
];
---
<section id="case-studies" aria-labelledby="case-studies-title" class="relative z-30 py-24 md:py-32 w-full bg-offwhite dark:bg-charcoal">
    <div class="max-w-7xl mx-auto px-4 md:px-16 flex flex-col gap-12 md:gap-16">
        <div class="flex flex-col gap-4 max-w-3xl mx-auto">
            <h2 id="case-studies-title" class="font-heading font-bold text-3xl md:text-5xl tracking-tight text-charcoal dark:text-white text-center">
                Selected work
            </h2>
            <p class="font-sans text-xl text-charcoal/80 dark:text-offwhite/80 leading-relaxed text-center">
                A few examples of the kind of products, systems, and teams I've supported across the stack.
            </p>
        </div>

        <ul class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 w-full">
            {projects.map((project, index) => (
                <li>
                    <article
                        aria-labelledby={`case-study-${index + 1}-title`}
                        class="flex h-full flex-col gap-4 rounded-2xl border border-charcoal/10 dark:border-offwhite/10 bg-charcoal/5 dark:bg-offwhite/5 p-8 hover:bg-charcoal/10 dark:hover:bg-offwhite/10 transition-colors duration-300"
                    >
                        <h3 id={`case-study-${index + 1}-title`} class="font-sans font-semibold text-xl text-charcoal dark:text-white">{project.name}</h3>
                        <p class="font-sans text-charcoal/70 dark:text-offwhite/70 text-base leading-relaxed">{project.intro}</p>
                        {(project.caseStudy || project.matchFlowUrl) && (
                            <div class="mt-auto pt-2 flex flex-wrap gap-2">
                                {project.matchFlowUrl && (
                                    <a
                                        href={project.matchFlowUrl}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        aria-label="Try Match Flow (opens in a new tab)"
                                        class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-charcoal dark:text-offwhite border border-charcoal/20 dark:border-offwhite/20 rounded-md hover:border-charcoal/40 dark:hover:border-offwhite/40 hover:text-charcoal dark:hover:text-white transition-colors duration-200"
                                    >
                                        Try Match Flow
                                    </a>
                                )}
                                {project.caseStudy && (
                                    <a
                                        href={project.caseStudy}
                                        class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-charcoal dark:text-offwhite border border-charcoal/20 dark:border-offwhite/20 rounded-md hover:border-charcoal/40 dark:hover:border-offwhite/40 hover:text-charcoal dark:hover:text-white transition-colors duration-200"
                                    >
                                        Read the case study
                                    </a>
                                )}
                            </div>
                        )}
                    </article>
                </li>
            ))}
        </ul>
    </div>
</section>
