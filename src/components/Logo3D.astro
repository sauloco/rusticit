---
import LogoR3D from "./react/LogoR3D";
import R from '../assets/r-gradient.svg';
---
<LogoR3D
    client:only="react"
    svgSrc={R.src}
    wrapperClassName="hidden md:block fixed pointer-events-none z-10 logo-float"
/>

<style>
@keyframes logo-float {
    0%, 100% { translate: 0 0px; }
    50%       { translate: 0 -18px; }
}
:global(.logo-float) {
    animation: logo-float 6s ease-in-out infinite;
}
</style>
